      "css": ".ds-index{width:220px;background:#091516;border-right:6px solid #E8B923;padding:6px;font:500 10pt 'Inter','Segoe UI',sans-serif}.ds-div{font-weight:600;font-size:9pt;padding:12px 14px 2px}.ds-item{display:flex;align-items:center;height:40px;padding:0 14px;border-radius:8px;color:#D3D7DA;border:1px solid transparent;cursor:pointer}.ds-item b{font:700 10pt 'JetBrains Mono',Consolas,monospace;color:#E8B923;width:24px}.ds-item:hover{background:#1A2526}.ds-item:focus-visible{outline:1px solid #E8B923}.ds-cur{background:#1A2526;border-color:#E8B923;color:#FFFFFF;font-weight:600}"
    },
    {
      "name": "Ruled Results Table",
      "kind": "custom",
      "refersTo": "field-sheet",
      "description": "Layout 3's ruled table: yellow header rule, hairline row rules, mono figures, yellow entry numbers.",
      "html": "<div class=\"ds-sheet\"><table class=\"ds-table\"><tr><th>#</th><th>Analysis</th><th>When</th><th>Result</th><th>Run</th></tr><tr><td class=\"ds-n\">03</td><td>Vegetation · NDVI</td><td class=\"ds-m\">24 Nov 18:05</td><td class=\"ds-m\">0.41</td><td class=\"ds-m\">GPU 3.2 s</td></tr><tr><td class=\"ds-n\">02</td><td>Surface temperature</td><td class=\"ds-m\">23 Nov 11:40</td><td class=\"ds-m\">34.7</td><td class=\"ds-m\">CPU 11.8 s</td></tr></table></div>",
      "css": ".ds-sheet{background:#173235;border:1px solid #2B4D4E;border-radius:6px;padding:20px 24px}.ds-table{border-collapse:collapse;color:#CFE5E0;font:10pt 'Inter','Segoe UI',sans-serif}.ds-table th{text-align:left;color:#A3C2BC;font-weight:600;font-size:9pt;padding:6px 8px;border-bottom:1px solid #E8B923}.ds-table td{padding:4px 6px;border-bottom:1px solid #2B4D4E}.ds-table tr:hover td{background:#1E3B3C}.ds-m{font:9pt 'JetBrains Mono',Consolas,monospace}.ds-n{font:600 10pt 'JetBrains Mono',Consolas,monospace;color:#E8B923}"
